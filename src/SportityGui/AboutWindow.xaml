<Window x:Class="SportityGui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="About SportityGui"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="28,24">

        <!-- Logo -->
        <Image Source="Assets/sportitylogo1.png" Height="56"
               HorizontalAlignment="Center" Margin="0,0,0,14"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- App name -->
        <TextBlock Text="SportityGui" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,4" />

        <!-- Version -->
        <TextBlock x:Name="VersionLabel" HorizontalAlignment="Center"
                   Opacity="0.7" Margin="0,0,0,4" />

        <!-- Author -->
        <TextBlock Text="By M. Gombert" HorizontalAlignment="Center"
                   Opacity="0.6" FontStyle="Italic" Margin="0,0,0,16" />

        <Separator Margin="0,0,0,14" />

        <!-- Links -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6">
                <Hyperlink x:Name="SportityLink" RequestNavigate="Link_RequestNavigate">
                    www.sportity.com
                </Hyperlink>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink x:Name="GitHubLink" RequestNavigate="Link_RequestNavigate">
                    github.com/ITMarco/SportityGui
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Separator Margin="0,0,0,14" />

        <!-- Disclaimer -->
        <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                   Opacity="0.6" FontStyle="Italic" FontSize="11"
                   LineHeight="18" Margin="0,0,0,20">
            This software is not affiliated with or endorsed by Sportity.
            No copyright infringement is intended. All Sportity content belongs
            to its respective owners. SportityGui is released under the
            GNU General Public License v3.0 (GPL-3.0).
        </TextBlock>

        <!-- Close button -->
        <Button Content="Close" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Center" Padding="28,7" />

    </StackPanel>
</Window>
