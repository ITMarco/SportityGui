<Window x:Class="SportityGui.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:SportityGui.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Preferences"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:StringEqualityConverter x:Key="StringEquality" />
    </Window.Resources>

    <StackPanel Margin="24,20">

        <!-- ─── Appearance ─── -->
        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,10" />

        <TextBlock Text="Theme" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <RadioButton Content="Light"
                         IsChecked="{Binding Theme, Converter={StaticResource StringEquality}, ConverterParameter=Light}"
                         Margin="0,0,20,0" />
            <RadioButton Content="Dark"
                         IsChecked="{Binding Theme, Converter={StaticResource StringEquality}, ConverterParameter=Dark}"
                         Margin="0,0,20,0" />
            <RadioButton Content="Follow system"
                         IsChecked="{Binding Theme, Converter={StaticResource StringEquality}, ConverterParameter=System}" />
        </StackPanel>

        <!-- ─── Downloads ─── -->
        <TextBlock Text="DOWNLOADS" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,10" />

        <TextBlock Text="Download folder" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" FontSize="12"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse…"
                    Command="{Binding BrowseFolderCommand}"
                    Padding="12,7" Margin="8,0,0,0" />
        </Grid>
        <Button Content="Reset to default"
                Command="{Binding ResetFolderCommand}"
                HorizontalAlignment="Left"
                Margin="0,0,0,14" />

        <CheckBox Content="Auto-download files when loading an event"
                  IsChecked="{Binding AutoDownload}"
                  Margin="0,0,0,8" />

        <CheckBox Content="Minimize to system tray only"
                  IsChecked="{Binding MinimizeToTray}"
                  ToolTip="When minimized, hide from the taskbar and show only in the system tray"
                  Margin="0,0,0,24" />

        <!-- ─── Background Refresh ─── -->
        <TextBlock Text="BACKGROUND REFRESH" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,28" VerticalAlignment="Center">
            <TextBlock Text="Auto-refresh every" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding AutoRefreshMinutes}"
                     Width="56" TextAlignment="Right" VerticalContentAlignment="Center" />
            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Text="  (0 = disabled)" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
        </StackPanel>

        <Separator Margin="0,0,0,16" />

        <!-- ─── Dialog buttons ─── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="20,7" Margin="0,0,10,0" />
            <Button Content="OK" IsDefault="True" Padding="20,7"
                    Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>

    </StackPanel>
</Window>
