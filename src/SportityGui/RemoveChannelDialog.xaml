<Window x:Class="SportityGui.RemoveChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Remove Channel"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <StackPanel Margin="24">

        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <RadioButton x:Name="KeepFilesRadio" Content="Keep downloaded files"
                     IsChecked="True" Margin="0,0,0,8"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <RadioButton x:Name="DeleteFilesRadio" Content="Also delete downloaded files from this channel"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <Separator Margin="0,16,0,12"
                   Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="20,8" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True" />
            <Button Content="Remove" Padding="20,8"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Remove_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
